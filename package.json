{
  "name": "telly-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixtures": "node e2e/fixtures/gen-fixtures.mjs --base http://127.0.0.1:8090 --out e2e/fixtures/site",
    "fixtures:serve": "node e2e/fixtures/serve.mjs",
    "e2e": "bddgen && playwright test",
    "e2e:ui": "bddgen && playwright test --ui",
    "quality": "bash scripts/quality.sh",
    "package:tizen": "bash platforms/tizen/package.sh",
    "package:webos": "bash platforms/webos/package.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.3",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "hls.js": "^1.7.4",
    "mpegts.js": "^1.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "license": "MIT",
  "description": "telly — a TiviMate-style, keyboard/remote-first IPTV player for the web (TV browsers, Xbox, desktop, mobile)"
}
